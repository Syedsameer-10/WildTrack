# Browser-visible configuration. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Backend runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted Supabase PostgreSQL/PostGIS (backend only)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Hosted MongoDB Atlas (backend only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DATABASE=wildtrack

# Added in the authentication phase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
